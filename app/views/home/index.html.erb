<div class="container">
  <div class="row min-vh-100 align-items-center justify-content-center py-5">
    <div class="col-12 col-lg-10">
      <div class="text-center mb-5">
        <h1 class="display-5 fw-bold mb-3">理想の宿を見つけよう</h1>
        <p class="lead text-muted mb-0">気になる施設名やキーワードから、ぴったりの宿泊先を検索できます</p>
      </div>

      <!-- 検索ボックス -->
      <div class="card border-0 shadow-sm mx-auto" style="max-width: 900px; background-color: #f8f9fa;">
        <div class="card-body p-4 p-md-5">
          <%= form_with url: rooms_search_path, method: :get, local: true do %>
            <div class="row g-3 align-items-center justify-content-center">
              <div class="col-12 col-md-9">
                <%= text_field_tag :freeword, params[:freeword], placeholder: "施設名・エリア・こだわり条件などで検索", autocomplete: "off", class: "form-control form-control-lg" %>
              </div>

              <div class="col-12 col-md-3 d-grid">
                <button type="submit" class="btn btn-primary btn-lg">
                  <i class="bi bi-search"></i> 検索
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- エリアカード -->
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mt-4">
        <div class="col">
          <%= link_to rooms_search_path(city: "tokyo"), class: "text-decoration-none text-dark" do %>
            <div class="card h-100 border-0 shadow-sm">
              <%= image_tag "/tokyo.png", class: "card-img-top", alt: "東京" %>
              <div class="card-body text-center">
                <h5 class="card-title mb-1">東京</h5>
                <p class="text-muted mb-0">Tokyo</p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="col">
          <%= link_to rooms_search_path(city: "osaka"), class: "text-decoration-none text-dark" do %>
            <div class="card h-100 border-0 shadow-sm">
              <%= image_tag "/osaka.png", class: "card-img-top", alt: "大阪" %>
              <div class="card-body text-center">
                <h5 class="card-title mb-1">大阪</h5>
                <p class="text-muted mb-0">Osaka</p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="col">
          <%= link_to rooms_search_path(city: "kyoto"), class: "text-decoration-none text-dark" do %>
            <div class="card h-100 border-0 shadow-sm">
              <%= image_tag "/kyoto.png", class: "card-img-top", alt: "京都" %>
              <div class="card-body text-center">
                <h5 class="card-title mb-1">京都</h5>
                <p class="text-muted mb-0">Kyoto</p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="col">
          <%= link_to rooms_search_path(city: "sapporo"), class: "text-decoration-none text-dark" do %>
            <div class="card h-100 border-0 shadow-sm">
              <%= image_tag "/sapporo.png", class: "card-img-top", alt: "札幌" %>
              <div class="card-body text-center">
                <h5 class="card-title mb-1">札幌</h5>
                <p class="text-muted mb-0">Sapporo</p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
  </div>
</div>
