<div class="container mt-4 mx-auto" style="max-width: 700px;">
  <h1 class="fs-4 mb-4">アカウント情報</h1>

  <!-- ユーザー情報 -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-12 col-md-4 text-muted">メールアドレス</dt>
        <dd class="col-12 col-md-8"><%= @user.email %></dd>

        <dt class="col-12 col-md-4 text-muted">パスワード</dt>
        <dd class="col-12 col-md-8">********</dd>

        <dt class="col-12 col-md-4 text-muted">名前</dt>
        <dd class="col-12 col-md-8"><%= @user.name %></dd>

        <dt class="col-12 col-md-4 text-muted">自己紹介</dt>
        <dd class="col-12 col-md-8"><%= @user.introduction.presence || "-" %></dd>
      </dl>
    </div>
  </div>

  <!-- ボタンエリア -->
  <div class="d-flex justify-content-between align-items-center">
    <%= link_to "戻る", root_path, class: "btn btn-outline-secondary" %>
    <div class="d-flex gap-2">
      <%= link_to "プロフィールを編集", edit_profile_user_path(back_to: request.fullpath), class: "btn btn-outline-primary" %>
      <%= link_to "アカウント情報を編集", edit_account_user_path(back_to: request.fullpath), class: "btn btn-primary" %>
    </div>
  </div>
</div>
