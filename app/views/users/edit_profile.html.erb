<div class="container mt-4 mx-auto" style="max-width: 700px;">
  <h1 class="fs-4 mb-4">プロフィール編集</h1>

  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: update_profile_user_path, method: :patch, html: { multipart: true } do |f| %>

    <!-- フォームカード -->
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">

          <div class="col-12">
            <%= f.label :name, "名前", class: "form-label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>

          <div class="col-12">
            <%= f.label :introduction, "自己紹介", class: "form-label" %>
            <%= f.text_area :introduction, class: "form-control", rows: 4 %>
          </div>

          <div class="col-12">
            <%= f.label :image, "アイコン画像", class: "form-label" %>
            <%= f.file_field :image, class: "form-control" %>
          </div>

        </div>
      </div>
    </div>

    <!-- ボタンエリア -->
    <div class="d-flex justify-content-between align-items-center">
      <%= link_to "戻る", params[:back_to].presence || user_path, class: "btn btn-outline-secondary" %>
      <%= f.submit "更新する", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>
