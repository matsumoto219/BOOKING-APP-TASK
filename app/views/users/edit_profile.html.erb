<h1>プロフィール編集</h1>

<% if @user.errors.any? %>
  <div>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: update_profile_user_path, method: :patch, html: { multipart: true } do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :introduction, "自己紹介" %><br>
    <%= f.text_area :introduction %>
  </div>

  <div>
    <%= f.label :image, "アイコン画像" %><br>
    <%= f.file_field :image %>
  </div>

  <div>
    <%= f.submit "更新" %>
  </div>
<% end %>

<p><%= link_to "戻る", user_path %></p>
