<h1>予約済み一覧</h1>

<table>
  <thead>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>合計料金</th>
      <th>チェックイン</th>
      <th>チェックアウト</th>
      <th>予約確定日時</th>
      <th>予約変更</th>
      <th>削除</th>
    </tr>
  </thead>

  <tbody>
    <% @reservations.each do |reservation| %>
      <tr>
        <td>
          <% if reservation.room.image_name.present? %>
            <%= image_tag reservation.room.image_name, size: "100x70" %>
          <% else %>
            <%= image_tag "/default_room.png", size: "100x70" %>
          <% end %>
        </td>
        <td><%= link_to reservation.room.name, room_path(reservation.room) %></td>
        <td><%= reservation.room.description %></td>
        <td><%= reservation.total_price %>円</td>
        <td><%= reservation.check_in.strftime("%Y/%m/%d") if reservation.check_in.present? %></td>
        <td><%= reservation.check_out.strftime("%Y/%m/%d") if reservation.check_out.present? %></td>
        <td><%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td><%= link_to "予約変更", edit_reservation_path(reservation) %></td>
        <td>
          <%= link_to "削除", reservation_path(reservation), data: { turbo_method: :delete, turbo_confirm: "予約を削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
