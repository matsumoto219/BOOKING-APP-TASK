<div class="container mt-4 mx-auto" style="max-width: 1400px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fs-4 mb-0">予約済み一覧</h1>
  </div>

  <!-- 一覧テーブル -->
  <div class="card shadow-sm w-100">
    <div class="card-body p-0 table-responsive">
      <table class="table table-striped table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>施設画像</th>
            <th>施設名</th>
            <th class="d-none d-md-table-cell">紹介文</th>
            <th>合計料金</th>
            <th>チェックイン</th>
            <th>チェックアウト</th>
            <th class="d-none d-md-table-cell">予約確定日時</th>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-table-cell d-md-none"></th>
          </tr>
        </thead>

        <tbody>
          <% @reservations.each do |reservation| %>
            <tr>
              <td>
                <% if reservation.room.image.attached? %>
                  <%= image_tag reservation.room.image, size: "100x70", class: "rounded" %>
                <% else %>
                  <%= image_tag "/default_room.png", size: "100x70", class: "rounded" %>
                <% end %>
              </td>
              <td>
                <%= link_to reservation.room.name, room_path(reservation.room, back_to: reservations_path), class: "text-decoration-none fw-bold" %>
              </td>
              <td class="d-none d-md-table-cell" title="<%= reservation.room.description %>">
                <%= truncate(reservation.room.description, length: 30) %>
              </td>
              <td><%= number_with_delimiter(reservation.total_price) %>円</td>
              <td><%= reservation.check_in.strftime("%Y/%m/%d") if reservation.check_in.present? %></td>
              <td><%= reservation.check_out.strftime("%Y/%m/%d") if reservation.check_out.present? %></td>
              <td class="d-none d-md-table-cell"><%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></td>

              <!-- ボタンエリア -->
              <td class="d-none d-md-table-cell">
                <%= link_to "予約変更", edit_reservation_path(reservation, back_to: request.fullpath), class: "btn btn-outline-secondary bi-pencil-square" %>
              </td>
              <td class="d-none d-md-table-cell">
                <%= link_to "取り消し", reservation_path(reservation), class: "btn btn-outline-danger bi-bookmark-x", data: { turbo_method: :delete, turbo_confirm: "予約を取り消しますか？" } %>
              </td>

              <!-- ボタンエリア(sp) -->
              <td class="d-table-cell d-md-none text-end">
                <div class="dropdown">
                  <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><%= link_to "予約変更", edit_reservation_path(reservation, back_to: request.fullpath), class: "dropdown-item" %></li>
                    <li>
                      <%= link_to "取り消し", reservation_path(reservation), class: "dropdown-item text-danger", data: { turbo_method: :delete, turbo_confirm: "予約を取り消しますか？" } %>
                    </li>
                  </ul>
                </div>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
