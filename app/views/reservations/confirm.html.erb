<div class="container mt-4 mx-auto" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fs-3 fw-bold mb-0">予約確認</h1>
    </div>
  </div>

  <!-- 確認画面 -->
  <div class="card border-0 shadow-sm mb-4 overflow-hidden">
    <div class="card-body p-0">
      <div class="row g-0 align-items-stretch">
        <div class="col-12 col-md-4">
          <% if @room.image.attached? %>
            <%= image_tag @room.image, class: "w-100 h-100", style: "min-height: 260px; object-fit: cover;" %>
          <% else %>
            <%= image_tag "/default_room.png", class: "w-100 h-100", style: "min-height: 260px; object-fit: cover;" %>
          <% end %>
        </div>

        <div class="col-12 col-md-8">
          <div class="p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3 flex-wrap">
              <div>
                <div class="text-muted small mb-1">ご予約内容</div>
                <h2 class="fs-4 fw-bold mb-2"><%= @room.name %></h2>
                <p class="text-muted mb-0">
                  <i class="bi bi-geo-alt me-1"></i><%= @room.address %>
                </p>
              </div>

              <div class="text-md-end">
                <div class="text-muted small mb-1">お支払い合計</div>
                <div class="fs-3 fw-bold text-primary"><%= number_with_delimiter(@total_price) %><span class="fs-6 text-dark">円</span></div>
              </div>
            </div>

            <div class="bg-light rounded-3 p-3 p-md-4">
              <div class="row g-3">
                <div class="col-12 col-sm-6">
                  <div class="text-muted small mb-1">チェックイン</div>
                  <div class="fw-semibold"><%= @reservation.check_in.strftime("%Y/%m/%d") %></div>
                </div>
                <div class="col-12 col-sm-6">
                  <div class="text-muted small mb-1">チェックアウト</div>
                  <div class="fw-semibold"><%= @reservation.check_out.strftime("%Y/%m/%d") %></div>
                </div>
                <div class="col-12 col-sm-4">
                  <div class="text-muted small mb-1">宿泊日数</div>
                  <div class="fw-semibold"><%= @stay_days %>日</div>
                </div>
                <div class="col-12 col-sm-4">
                  <div class="text-muted small mb-1">人数</div>
                  <div class="fw-semibold"><%= @reservation.people %>人</div>
                </div>
                <div class="col-12 col-sm-4">
                  <div class="text-muted small mb-1">1泊あたり</div>
                  <div class="fw-semibold"><%= number_with_delimiter(@room.price) %>円</div>
                </div>
              </div>
            </div>

            <div class="alert alert-light border mt-3 mb-0">
              上記の内容でよろしければ予約を確定してください。
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ボタンエリア -->
  <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
    <%= link_to "入力画面に戻る", new_reservation_path(room_id: @room.id, back_to: params[:back_to]), class: "btn btn-outline-secondary bi-chevron-compact-left" %>

    <%= form_with model: @reservation, url: reservations_path do |f| %>
      <%= f.hidden_field :room_id %>
      <%= f.hidden_field :check_in %>
      <%= f.hidden_field :check_out %>
      <%= f.hidden_field :people %>
      <button type="submit" class="btn btn-primary px-4">
        <i class="bi bi-check-circle"></i> 予約を確定する
      </button>
    <% end %>
  </div>
</div>
