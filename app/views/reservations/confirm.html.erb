<div class="container mt-4 mx-auto" style="max-width: 900px;">
  <h1 class="fs-4 mb-4">予約確認</h1>

  <!-- 確認画面 -->
  <div class="card shadow-sm mb-3">
    <div class="card-body">
      <div class="row g-4 align-items-start">
        <div class="col-12 col-md-4">
          <% if @room.image.attached? %>
            <%= image_tag @room.image, class: "img-fluid rounded w-100" %>
          <% else %>
            <%= image_tag "/default_room.png", class: "img-fluid rounded w-100" %>
          <% end %>
        </div>

        <div class="col-12 col-md-8">
          <table class="table table-borderless mb-0">
            <tbody>
              <tr>
                <th class="ps-0" style="width: 180px;">施設名</th>
                <td><%= @room.name %></td>
              </tr>
              <tr>
                <th class="ps-0">チェックイン</th>
                <td><%= @reservation.check_in.strftime("%Y/%m/%d") %></td>
              </tr>
              <tr>
                <th class="ps-0">チェックアウト</th>
                <td><%= @reservation.check_out.strftime("%Y/%m/%d") %></td>
              </tr>
              <tr>
                <th class="ps-0">宿泊日数</th>
                <td><%= @stay_days %>日</td>
              </tr>
              <tr>
                <th class="ps-0">人数</th>
                <td><%= @reservation.people %>人</td>
              </tr>
              <tr>
                <th class="ps-0">支払い金額</th>
                <td class="fw-bold"><%= @total_price %>円</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ボタンエリア -->
  <div class="d-flex justify-content-between mt-3">
    <div>
      <%= link_to "入力画面に戻る", new_reservation_path(room_id: @room.id, back_to: params[:back_to]), class: "btn btn-outline-secondary" %>
    </div>

    <div>
      <%= form_with model: @reservation, url: reservations_path do |f| %>
        <%= f.hidden_field :room_id %>
        <%= f.hidden_field :check_in %>
        <%= f.hidden_field :check_out %>
        <%= f.hidden_field :people %>
        <%= f.submit "予約を確定する", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
