<div class="container mt-4 mx-auto" style="max-width: 900px;">
  <h1 class="fs-4 mb-4">予約入力</h1>

  <% if @reservation.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @reservation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @reservation, url: confirm_reservations_path, data: { turbo: false } do |f| %>
    <%= f.hidden_field :room_id, value: @room.id %>

    <!-- 施設情報 -->
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="row align-items-center g-3">
          <div class="col-12 col-md-4 text-center">
            <% if @room.image.attached? %>
              <%= image_tag @room.image, class: "img-fluid rounded", style: "max-height: 220px; object-fit: cover;" %>
            <% else %>
              <%= image_tag "/default_room.png", class: "img-fluid rounded", style: "max-height: 220px; object-fit: cover;" %>
            <% end %>
          </div>

          <div class="col-12 col-md-8">
            <h2 class="fs-5 fw-bold mb-3"><%= @room.name %></h2>
            <p class="mb-2"><strong>住所:</strong> <%= @room.address %></p>
            <p class="mb-0"><strong>料金:</strong> <%= @room.price %>円 / 日</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 予約入力 -->
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <%= f.label :check_in, "チェックイン", class: "form-label" %>
            <%= f.date_field :check_in, class: "form-control" %>
          </div>

          <div class="col-12 col-md-4">
            <%= f.label :check_out, "チェックアウト", class: "form-label" %>
            <%= f.date_field :check_out, class: "form-control" %>
          </div>

          <div class="col-12 col-md-4">
            <%= f.label :people, "人数", class: "form-label" %>
            <%= f.number_field :people, class: "form-control", min: 1 %>
          </div>
        </div>
      </div>
    </div>

    <!-- ボタンエリア -->
    <div class="d-flex justify-content-between align-items-center">
      <%= link_to "戻る", params[:back_to].presence || room_path(@room), class: "btn btn-outline-secondary" %>
      <%= f.submit "予約確認へ進む", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
