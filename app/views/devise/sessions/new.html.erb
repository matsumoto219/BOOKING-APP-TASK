<div class="container mt-5 mx-auto" style="max-width: 500px;">
  <h2 class="mb-4 text-center">ログイン</h2>

  <div class="card shadow-sm">
    <div class="card-body">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <!-- 入力フォーム -->
        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-3">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, "ログイン状態を保持", class: "form-check-label" %>
          </div>
        <% end %>

        <!-- ボタンエリア -->
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi-box-arrow-in-right"></i> ログイン
          </button>
          <%= link_to " アカウント作成", new_registration_path(resource_name), class: "btn btn-outline-primary bi-person-fill-add" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
