<header>
  <!-- 検索フォーム -->
  <%= form_with url: rooms_search_path, method: :get, local: true do |f| %>
    <%= f.text_field :keyword, placeholder: "エリア・施設名・施設詳細で検索" %>
    <%= f.submit "検索" %>
  <% end %>

  <!-- サインインチェック -->
  <% if user_signed_in? %>
    <div class="header-user">
      <% if current_user.image.attached? %>
        <%= image_tag current_user.image, size: "40x40", class: "header-icon" %>
      <% else %>
        <%= image_tag "/default_user.png", size: "40x40", class: "header-icon" %>
      <% end %>

      <span class="header-username"><%= current_user.name %> さん</span>

      <div class="header-menu">
        <%= link_to "アカウント", user_path %>
        <%= link_to "プロフィール編集", edit_profile_user_path %>
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %>
      </div>
    </div>
  <% else %>
    <%= link_to "ログイン", new_user_session_path %>
    <%= link_to "新規登録", new_user_registration_path %>
  <% end %>
</header>
