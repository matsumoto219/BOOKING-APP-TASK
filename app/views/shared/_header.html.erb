<header class="shadow-sm mb-2" style="background-color: #ffffff; height: 64px;">
  <div class="container d-flex justify-content-between align-items-center px-3" style="max-width: 1100px; height: 100%;">
    <!-- 左：サービス名 -->
    <div class="header-left">
      <%= link_to "Booking App", root_path, class: "fw-bold fs-5 text-dark text-decoration-none" %>
    </div>

    <!-- 右：ユーザー関連 -->
    <div class="header-right">
      <% if user_signed_in? %>
        <div class="dropdown">
          <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <% if current_user.image.attached? %>
              <%= image_tag current_user.image, size: "36x36", class: "rounded-circle" %>
            <% else %>
              <%= image_tag "/default_user.png", size: "36x36", class: "rounded-circle" %>
            <% end %>
            <span class="fw-bold"><%= current_user.name %> さん</span>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li><%= link_to "アカウント", user_path, class: "dropdown-item" %></li>
            <li><%= link_to "プロフィール編集", edit_profile_user_path, class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= link_to "ログアウト", destroy_user_session_path, class: "dropdown-item text-danger", data: { turbo_method: :delete } %>
            </li>
          </ul>
        </div>
      <% else %>
        <div class="d-flex gap-2">
          <%= link_to "ログイン", new_user_session_path, class: "btn btn-sm btn-outline-primary" %>
          <%= link_to "新規登録", new_user_registration_path, class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</header>
