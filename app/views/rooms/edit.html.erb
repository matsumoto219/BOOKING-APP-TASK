<div class="container mt-4" style="max-width: 700px;">
  <h1 class="mb-4 fs-4">施設情報編集</h1>

  <% if @room.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @room.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 入力フォーム -->
  <%= form_with model: @room, html: { multipart: true } do |f| %>
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="mb-3">
          <%= f.label :name, "施設名", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :description, "施設詳細", class: "form-label" %>
          <%= f.text_area :description, class: "form-control", rows: 4 %>
        </div>

        <div class="mb-3">
          <%= f.label :price, "料金", class: "form-label" %>
          <%= f.number_field :price, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :address, "住所", class: "form-label" %>
          <%= f.text_field :address, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :image, "施設画像", class: "form-label" %>
          <%= f.file_field :image, class: "form-control" %>
        </div>
      </div>
    </div>

    <!-- ボタンエリア -->
    <div class="d-flex justify-content-between">
      <%= link_to "戻る", room_path(@room), class: "btn btn-outline-secondary" %>
      <%= f.submit "更新", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
