<h1>施設情報編集</h1>

<% if @room.errors.any? %>
  <div>
    <ul>
      <% @room.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @room, html: { multipart: true } do |f| %>
  <div>
    <%= f.label :name, "施設名" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description, "施設詳細" %><br>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :price, "料金" %><br>
    <%= f.number_field :price %>
  </div>

  <div>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :image, "施設画像" %><br>
    <%= f.file_field :image %>
  </div>

  <div>
    <%= f.submit "更新" %>
  </div>
<% end %>

<p><%= link_to "戻る", room_path(@room) %></p>
