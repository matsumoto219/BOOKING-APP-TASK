<div class="container mt-4 mx-auto" style="max-width: 1400px;">

  <!-- タイトル/登録ボタン -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fs-4 mb-0">登録済み施設一覧</h1>
    <%= link_to "施設登録", new_room_path(back_to: rooms_path), class: "btn btn-primary" %>
  </div>

  <!-- 一覧テーブル -->
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <table class="table table-striped table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>施設画像</th>
            <th>施設名</th>
            <th>施設詳細</th>
            <th>料金</th>
            <th>住所</th>
            <th>作成日</th>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-table-cell d-md-none"></th>
          </tr>
        </thead>

        <tbody>
          <% @rooms.each do |room| %>
            <tr>
              <td>
                <% if room.image.attached? %>
                  <%= image_tag room.image, size: "100x70", class: "rounded" %>
                <% else %>
                  <%= image_tag "/default_room.png", size: "100x70", class: "rounded" %>
                <% end %>
              </td>

              <td>
                <%= link_to room.name, room_path(room), class: "text-decoration-none fw-bold" %>
              </td>
              <td title="<%= room.description %>">
                <%= truncate(room.description, length: 30) %>
              </td>
              <td><%= number_with_delimiter(room.price) %>円</td>
              <td><%= room.address %></td>
              <td><%= room.created_at.strftime("%Y/%m/%d") %></td>

              <!-- ボタンエリア -->
              <td class="d-none d-md-table-cell">
                <%= link_to "編集", edit_room_path(room, back_to: rooms_path), class: "btn btn-outline-secondary" %>
              </td>
              <td class="d-none d-md-table-cell">
                <%= link_to "削除", room_path(room), class: "btn btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "施設を削除しますか?\nこの操作は取り消せません。" } %>
              </td>

              <!-- ボタンエリア(sp) -->
              <td class="d-table-cell d-md-none text-end">
                <div class="dropdown">
                  <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li><%= link_to "編集", edit_room_path(room, back_to: rooms_path), class: "dropdown-item" %></li>
                    <li>
                      <%= link_to "削除", room_path(room), class: "dropdown-item text-danger", data: { turbo_method: :delete, turbo_confirm: "施設を削除しますか?\nこの操作は取り消せません。" } %>
                    </li>
                  </ul>
                </div>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
