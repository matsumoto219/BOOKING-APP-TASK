<div class="container mt-4" style="max-width: 960px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-0 fs-3 fw-bold">施設詳細</h1>
    </div>
    <%= link_to "戻る", params[:back_to].presence || rooms_path, class: "btn btn-outline-secondary bi-chevron-compact-left" %>
  </div>

  <% if @room.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @room.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card border-0 shadow-sm overflow-hidden mb-4">
    <!-- 施設画像 -->
    <div class="w-100">
      <% if @room.image.attached? %>
        <%= image_tag @room.image, class: "w-100", style: "height: 420px; object-fit: cover; border-top-left-radius: .5rem; border-top-right-radius: .5rem;" %>
      <% else %>
        <%= image_tag "/default_room.png", class: "w-100", style: "height: 420px; object-fit: cover; border-top-left-radius: .5rem; border-top-right-radius: .5rem;" %>
      <% end %>
    </div>

    <!-- 施設詳細 -->
    <div class="card-body p-4 p-lg-5 d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
          <h2 class="fs-3 fw-bold mb-2"><%= @room.name %></h2>
          <p class="text-muted mb-0">
            <i class="bi bi-geo-alt me-1"></i><%= @room.address %>
          </p>
        </div>
        <div class="text-end">
          <div class="text-muted small">1泊あたり</div>
          <div class="fs-3 fw-bold text-primary"><%= number_with_delimiter(@room.price) %><span class="fs-6 text-dark">円</span></div>
        </div>
      </div>

      <div class="mb-4">
        <h3 class="fs-6 fw-semibold text-uppercase text-muted mb-2">施設紹介</h3>
        <p class="mb-0 lh-lg"><%= @room.description.presence %></p>
      </div>

      <!-- ボタンエリア -->
      <div class="mt-auto">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <div class="d-flex gap-2">
            <% if user_signed_in? && current_user.id == @room.user_id %>
              <%= link_to "編集", edit_room_path(@room, back_to: request.fullpath), class: "btn btn-outline-secondary bi-pencil-square" %>
              <%= link_to "削除", room_path(@room), class: "btn btn-outline-danger bi-trash", data: { turbo_method: :delete, turbo_confirm: "施設を削除しますか?\nこの操作は取り消せません。" } %>
            <% end %>
          </div>

          <div>
            <%= link_to "予約に進む", new_reservation_path(room_id: @room.id, back_to: request.fullpath), class: "btn btn-primary bi-chevron-compact-right px-4" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
