<h1>施設詳細</h1>

<p>
  <% if @room.image.attached? %>
    <%= image_tag @room.image, size: "300x200" %>
  <% else %>
    <%= image_tag "/default_room.png", size: "300x200" %>
  <% end %>
</p>

<p>施設名: <%= @room.name %></p>
<p>施設詳細: <%= @room.description %></p>
<p>料金: <%= @room.price %>円</p>
<p>住所: <%= @room.address %></p>

<%= link_to "予約する", new_reservation_path(room_id: @room.id) %>

<p><%= link_to "戻る", request.referer || rooms_path %></p>
