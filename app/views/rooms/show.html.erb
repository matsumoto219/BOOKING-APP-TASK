<div class="container mt-4" style="max-width: 900px;">
  <h1 class="mb-4 fs-4">施設詳細</h1>

  <% if @room.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @room.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 施設詳細 -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="row align-items-start">
        <div class="col-12 col-md-4 mb-3 mb-md-0">
          <% if @room.image.attached? %>
            <%= image_tag @room.image, class: "img-fluid rounded w-100", style: "height: 200px; object-fit: cover;" %>
          <% else %>
            <%= image_tag "/default_room.png", class: "img-fluid rounded w-100", style: "height: 200px; object-fit: cover;" %>
          <% end %>
        </div>

        <div class="col-12 col-md-8">
          <div class="mb-2"><strong>施設名:</strong> <%= @room.name %></div>
          <div class="mb-2"><strong>施設詳細:</strong> <%= @room.description %></div>
          <div class="mb-2"><strong>料金:</strong> <%= @room.price %>円</div>
          <div class="mb-2"><strong>住所:</strong> <%= @room.address %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ボタンエリア -->
  <div class="d-flex justify-content-between align-items-center">
    <%= link_to "戻る", request.referer || rooms_path, class: "btn btn-outline-secondary" %>

    <div class="d-flex gap-2">
      <% if user_signed_in? && current_user.id == @room.user_id %>
        <%= link_to "削除", room_path(@room), class: "btn btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "施設を削除しますか?\nこの操作は取り消せません。" } %>
        <%= link_to "編集", edit_room_path(@room), class: "btn btn-outline-secondary" %>
      <% end %>
      <%= link_to "予約に進む", new_reservation_path(room_id: @room.id), class: "btn btn-primary" %>
    </div>
  </div>
</div>
